* text=auto

# Shell scripts and source fixtures are consumed byte-for-byte by release tests.
*.sh text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.nsh text eol=lf

# Binary application and test assets must never receive line-ending conversion.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.zip binary
*.dmg binary
*.exe binary
*.dll binary

# Generated verbatim from upstream license texts; preserve their legal wording
# and do not report upstream trailing spaces as project-source whitespace errors.
THIRD_PARTY_LICENSES_RUST.html -whitespace
