<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Paper Float Translator - Rust third-party licenses</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.5; margin: 2rem auto; max-width: 72rem; padding: 0 1rem; }
    pre { border: 1px solid #d8dee8; border-radius: 0.5rem; overflow-x: auto; padding: 1rem; white-space: pre-wrap; }
    .used-by { margin-top: -0.5rem; }
  </style>
</head>
<body>
  <main>
    <h1>Rust third-party licenses</h1>
    <p>Generated from the locked Paper Float Translator Cargo dependency graph with cargo-about 0.9.1.</p>
    <p>Project code is licensed separately under Apache-2.0; see LICENSE and NOTICE.</p>
    {{#each licenses}}
    <section>
      <h2>{{name}}</h2>
      <p class="used-by">Used by:</p>
      <ul>
        {{#each used_by}}
        <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
    {{/each}}
  </main>
</body>
</html>
