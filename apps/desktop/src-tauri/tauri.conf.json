{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paper Float Translator",
  "version": "0.1.1",
  "identifier": "com.paperfloat.translator",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Paper Float Translator",
        "url": "index.html",
        "width": 860,
        "height": 720,
        "resizable": true,
        "visible": true
      },
      {
        "label": "popup",
        "title": "Paper Float Translator",
        "url": "index.html?view=popup",
        "width": 440,
        "height": 66,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Paper Float Translator",
    "copyright": "Copyright © 2026 Jinke Lin and contributors",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../NOTICE": "licenses/NOTICE",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../../THIRD_PARTY_LICENSES_NPM.txt": "licenses/THIRD_PARTY_LICENSES_NPM.txt",
      "../../../THIRD_PARTY_LICENSES_RUST.html": "licenses/THIRD_PARTY_LICENSES_RUST.html"
    },
    "category": "Productivity"
  }
}
