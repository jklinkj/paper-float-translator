{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paper Float Translator Acceptance",
  "identifier": "com.paperfloat.translator.acceptance",
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Paper Float Translator Acceptance",
        "url": "index.html",
        "width": 860,
        "height": 720,
        "resizable": true,
        "visible": true
      },
      {
        "label": "popup",
        "title": "Paper Float Translator Acceptance",
        "url": "index.html?view=popup",
        "width": 440,
        "height": 66,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
