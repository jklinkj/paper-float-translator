{
  "name": "@paper-float-translator/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build:core": "npm run build -w @paper-float-translator/core",
    "dev:renderer": "npm run build:core && vite --host 127.0.0.1 --port 1420",
    "build": "tauri build",
    "build:renderer": "npm run build:core && vite build",
    "build:mac:app": "tauri build --bundles app",
    "build:mac:app:local": "CARGO_TARGET_DIR=src-tauri/target/local-api-key-file tauri build --bundles app --features local-api-key-file --config '{\"bundle\":{\"macOS\":{\"signingIdentity\":\"-\"}}}'",
    "build:mac:app:acceptance": "CARGO_TARGET_DIR=target/acceptance tauri build --bundles app --features acceptance-testing --config src-tauri/tauri.acceptance.conf.json",
    "build:mac:app:local-signed": "bash scripts/build-mac-app-local-signed.sh",
    "build:mac:arm64": "tauri build --target aarch64-apple-darwin",
    "build:mac:x64": "tauri build --target x86_64-apple-darwin",
    "preview": "vite preview --host 127.0.0.1",
    "sign:mac:app": "bash scripts/sign-mac-app.sh",
    "verify:mac": "bash scripts/verify-mac-release.sh",
    "verify:mac:artifact-isolation": "bash scripts/verify-mac-artifact-isolation.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@paper-float-translator/core": "0.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.2"
  }
}
